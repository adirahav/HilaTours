{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "api",
    "skipLibCheck": true
  },
  "include": ["api/**/*"],
  "exclude": ["node_modules", "dist"]
}
